<?xml version="1.0" encoding="utf-8"?>
<!-- Mint glass panel: translucent gradient, fine light border, soft corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/widget_glass_top"
        android:endColor="@color/widget_glass_bottom" />
    <stroke android:width="1dp" android:color="@color/widget_stroke" />
    <corners android:radius="24dp" />
</shape>

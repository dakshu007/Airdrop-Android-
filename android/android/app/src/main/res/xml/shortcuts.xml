<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share: paired devices appear in the share sheet's top row for any file or text. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.crossdrop.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.crossdrop.category.SEND_TO_DEVICE" />
    </share-target>
</shortcuts>
